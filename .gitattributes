# Tidy3D Linguist attributes
public/tidy3d/docs/faq/* linguist-vendored
public/tidy3d/docs/notebooks/* linguist-vendored
public/tidy3d/tests/* linguist-vendored

# Tidy3D CHANGELOG merge strategy
public/tidy3d/CHANGELOG.md merge=union

# Git LFS tracking for Tidy3D large files (path-scoped)
public/tidy3d/**/*.ipynb filter=lfs diff=lfs merge=lfs -text
public/tidy3d/**/*.hdf5 filter=lfs diff=lfs merge=lfs -text
public/tidy3d/**/*.hdf5.gz filter=lfs diff=lfs merge=lfs -text
public/tidy3d/**/*.h5 filter=lfs diff=lfs merge=lfs -text
